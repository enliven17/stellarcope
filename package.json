{
  "name": "stellarcope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node scripts/copy-tracker.mjs && vite",
    "build": "node scripts/copy-tracker.mjs && tsc -b && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "brand": "node scripts/brand.mjs",
    "test": "node --test \"packages/**/*.test.ts\" \"services/**/*.test.ts\"",
    "smoke:pilot:postgres": "node scripts/pilot-postgres-smoke.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json && tsc -p api/tsconfig.json --noEmit && tsc -p packages/ingestion/tsconfig.json && tsc -p services/ingress/tsconfig.json",
    "seed": "node --env-file=.env.local scripts/seed.ts",
    "pilot": "node --env-file-if-exists=.env.local scripts/pilot.ts",
    "lint": "eslint packages/ingestion services/ingress",
    "format:check": "prettier --check \"packages/ingestion/**/*.{ts,json}\" \"services/ingress/**/*.{ts,json}\" eslint.config.mjs .prettierrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "start:ingress": "node services/ingress/main.ts",
    "start:pilot": "node --env-file-if-exists=.env.local services/pilot/main.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@stellar/stellar-sdk": "17.4.0",
    "@vercel/functions": "^1.5.2",
    "fastify": "5.12.8",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "motion": "^12.23.12",
    "pg": "^8.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "node-pg-migrate": {
      "glob": "14.0.6"
    }
  }
}
