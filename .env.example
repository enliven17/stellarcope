# Use a disposable local PostgreSQL database for development.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/stellarcope_pilot
PILOT_ORIGIN=http://localhost:5173
PILOT_PORT=8787
# Deployment: set PILOT_ORIGIN to the exact HTTPS frontend origin.
# Optional: VITE_API_PROXY=http://127.0.0.1:8787
# Legacy sealing additionally requires operator-managed CRON_SECRET,
# ANCHOR_SECRET, ANCHOR_PUBLIC and HORIZON_URL; never commit real values.
